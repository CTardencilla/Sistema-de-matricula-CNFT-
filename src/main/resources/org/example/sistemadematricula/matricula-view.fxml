<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.sistemadematricula.MatriculaController"
        prefWidth="1100"
        prefHeight="700"
        style="-fx-background-color: #f2f2f2;">



    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="15"
                style="-fx-background-color: #2f4f4f;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <ImageView
                    fitWidth="55"
                    fitHeight="55"
                    preserveRatio="true"/>

            <VBox spacing="3">

                <Label
                        text="Centro Nicaragüense de Formación Tecnológica"
                        textFill="WHITE">

                    <font>
                        <Font name="System Bold" size="20"/>
                    </font>

                </Label>

                <Label
                        text="Sistema de Matrícula"
                        textFill="WHITE"/>

            </VBox>

        </HBox>
    </top>


    <!-- CONTENIDO -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>


            <!-- FORMULARIO -->

            <VBox
                    spacing="15"
                    style="-fx-background-color: white;
                           -fx-padding: 20;
                           -fx-border-color: #cccccc;">

                <Label text="Datos del estudiante">

                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>

                </Label>


                <GridPane
                        hgap="15"
                        vgap="12">

                    <columnConstraints>

                        <ColumnConstraints
                                prefWidth="140"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"
                                prefWidth="250"/>

                        <ColumnConstraints
                                prefWidth="140"/>

                        <ColumnConstraints
                                hgrow="ALWAYS"
                                prefWidth="250"/>

                    </columnConstraints>




                    <Label
                            text="Nombres:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <TextField
                            fx:id="txtNombres"
                            promptText="Ingrese nombres"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>


                    <!-- APELLIDOS -->

                    <Label
                            text="Apellidos:"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"/>

                    <TextField
                            fx:id="txtApellidos"
                            promptText="Ingrese apellidos"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>




                    <Label
                            text="Usuario:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <TextField
                            fx:id="txtUsuario"
                            promptText="Mínimo 5 caracteres"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>




                    <Label
                            text="Contraseña:"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="1"/>

                    <PasswordField
                            fx:id="txtContrasena"
                            promptText="Mínimo 8 caracteres"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>


                    <!-- FECHA -->

                    <Label
                            text="Fecha de nacimiento:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <DatePicker
                            fx:id="dpFechaNacimiento"
                            maxWidth="Infinity"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>


                    <!-- DEPARTAMENTO -->

                    <Label
                            text="Departamento:"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="2"/>

                    <ComboBox
                            fx:id="cbDepartamento"
                            promptText="Seleccione"
                            maxWidth="Infinity"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>


                    <!-- CURSO -->

                    <Label
                            text="Curso:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <ListView
                            fx:id="lvCursos"
                            prefHeight="100"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>


                    <!-- MODALIDAD -->

                    <Label
                            text="Modalidad:"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="3"/>

                    <VBox
                            spacing="8"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="3">

                        <RadioButton
                                fx:id="rbPresencial"
                                text="Presencial"/>

                        <RadioButton
                                fx:id="rbVirtual"
                                text="Virtual"/>

                    </VBox>


                    <!-- HORARIO -->

                    <Label
                            text="Horario:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="4"/>

                    <HBox
                            spacing="15"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="4"
                            GridPane.columnSpan="3">

                        <CheckBox
                                fx:id="chkManana"
                                text="Mañana"/>

                        <CheckBox
                                fx:id="chkTarde"
                                text="Tarde"/>

                        <CheckBox
                                fx:id="chkNoche"
                                text="Noche"/>

                    </HBox>


                    <!-- NORMAS -->

                    <CheckBox
                            fx:id="chkNormas"
                            text="Acepto las normas del centro"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="5"
                            GridPane.columnSpan="4"/>

                </GridPane>


                <!-- BOTONES -->

                <HBox
                        alignment="CENTER_RIGHT"
                        spacing="10">

                    <Button
                            text="Limpiar"
                            onAction="#limpiarFormulario"
                            style="-fx-background-color: #dddddd;
                                   -fx-padding: 8 20;"/>

                    <Button
                            text="Registrar"
                            onAction="#registrarEstudiante"
                            style="-fx-background-color: #2f4f4f;
                                   -fx-text-fill: white;
                                   -fx-padding: 8 20;"/>

                </HBox>

            </VBox>


            <!-- TABLA -->

            <VBox spacing="10">

                <Label text="Estudiantes matriculados">

                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>

                </Label>


                <TableView
                        fx:id="tablaEstudiantes"
                        prefHeight="260">

                    <columns>

                        <TableColumn
                                fx:id="colNombre"
                                text="Nombre completo"
                                prefWidth="200"/>

                        <TableColumn
                                fx:id="colDepartamento"
                                text="Departamento"
                                prefWidth="150"/>

                        <TableColumn
                                fx:id="colCurso"
                                text="Curso"
                                prefWidth="150"/>

                        <TableColumn
                                fx:id="colModalidad"
                                text="Modalidad"
                                prefWidth="120"/>

                        <TableColumn
                                fx:id="colHorario"
                                text="Horario"
                                prefWidth="150"/>

                        <TableColumn
                                fx:id="colFechaNacimiento"
                                text="Fecha de nacimiento"
                                prefWidth="170"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>