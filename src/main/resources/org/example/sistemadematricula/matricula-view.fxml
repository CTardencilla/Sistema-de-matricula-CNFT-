<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.sistemadematricula.MatriculaController"
        prefWidth="1200.0"
        prefHeight="750.0"
        style="-fx-background-color: #F4F7F9;">


    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20.0"
                style="-fx-background-color: #173F5F;">

            <padding>
                <Insets
                        top="18.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>


            <!-- ImageView solicitado en la guía -->

            <ImageView
                    fitWidth="70.0"
                    fitHeight="70.0"
                    preserveRatio="true"/>


            <VBox spacing="4.0">

                <Label
                        text="Centro Nicaragüense de Formación Tecnológica"
                        textFill="WHITE">

                    <font>
                        <Font
                                name="System Bold"
                                size="23.0"/>
                    </font>

                </Label>


                <Label
                        text="Sistema de Matrícula de Estudiantes"
                        textFill="#DDEAF2">

                    <font>
                        <Font size="15.0"/>
                    </font>

                </Label>

            </VBox>

        </HBox>

    </top>


    <!-- ===================================================== -->
    <!-- CONTENIDO -->
    <!-- ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                style="-fx-background-color: transparent;
                       -fx-background: #F4F7F9;">

            <content>

                <VBox spacing="22.0">

                    <padding>
                        <Insets
                                top="25.0"
                                right="30.0"
                                bottom="30.0"
                                left="30.0"/>
                    </padding>


                    <!-- ====================================== -->
                    <!-- FORMULARIO -->
                    <!-- ====================================== -->

                    <VBox
                            spacing="18.0"
                            style="-fx-background-color: white;
                                   -fx-background-radius: 12;
                                   -fx-padding: 25;">

                        <Label
                                text="Datos del estudiante"
                                style="-fx-text-fill: #173F5F;">

                            <font>
                                <Font
                                        name="System Bold"
                                        size="21.0"/>
                            </font>

                        </Label>


                        <Label
                                text="Complete la información para realizar la matrícula."
                                style="-fx-text-fill: #64748B;"/>


                        <GridPane
                                hgap="20.0"
                                vgap="16.0">

                            <columnConstraints>

                                <ColumnConstraints
                                        minWidth="130.0"
                                        prefWidth="150.0"/>

                                <ColumnConstraints
                                        hgrow="ALWAYS"
                                        minWidth="220.0"/>

                                <ColumnConstraints
                                        minWidth="130.0"
                                        prefWidth="150.0"/>

                                <ColumnConstraints
                                        hgrow="ALWAYS"
                                        minWidth="220.0"/>

                            </columnConstraints>


                            <!-- ============================== -->
                            <!-- NOMBRES -->
                            <!-- ============================== -->

                            <Label
                                    text="Nombres:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="txtNombres"
                                    promptText="Ingrese los nombres"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <!-- ============================== -->
                            <!-- APELLIDOS -->
                            <!-- ============================== -->

                            <Label
                                    text="Apellidos:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="txtApellidos"
                                    promptText="Ingrese los apellidos"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- ============================== -->
                            <!-- USUARIO -->
                            <!-- ============================== -->

                            <Label
                                    text="Usuario:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <TextField
                                    fx:id="txtUsuario"
                                    promptText="Mínimo 5 caracteres"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <!-- ============================== -->
                            <!-- CONTRASEÑA -->
                            <!-- ============================== -->

                            <Label
                                    text="Contraseña:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <PasswordField
                                    fx:id="txtContrasena"
                                    promptText="Mínimo 8 caracteres"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- ============================== -->
                            <!-- FECHA -->
                            <!-- ============================== -->

                            <Label
                                    text="Fecha de nacimiento:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <DatePicker
                                    fx:id="dpFechaNacimiento"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <!-- ============================== -->
                            <!-- DEPARTAMENTO -->
                            <!-- ============================== -->

                            <Label
                                    text="Departamento:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <ComboBox
                                    fx:id="cbDepartamento"
                                    promptText="Seleccione un departamento"
                                    maxWidth="Infinity"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <!-- ============================== -->
                            <!-- CURSO -->
                            <!-- ============================== -->

                            <Label
                                    text="Curso:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <ListView
                                    fx:id="lvCursos"
                                    prefHeight="115.0"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>


                            <!-- ============================== -->
                            <!-- MODALIDAD -->
                            <!-- ============================== -->

                            <Label
                                    text="Modalidad:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="3"/>

                            <VBox
                                    spacing="10.0"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="3">

                                <RadioButton
                                        fx:id="rbPresencial"
                                        text="Presencial"/>

                                <RadioButton
                                        fx:id="rbVirtual"
                                        text="Virtual"/>

                            </VBox>


                            <!-- ============================== -->
                            <!-- HORARIOS -->
                            <!-- ============================== -->

                            <Label
                                    text="Horario:"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="4"/>

                            <HBox
                                    spacing="18.0"
                                    alignment="CENTER_LEFT"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4"
                                    GridPane.columnSpan="3">

                                <CheckBox
                                        fx:id="chkManana"
                                        text="Mañana"/>

                                <CheckBox
                                        fx:id="chkTarde"
                                        text="Tarde"/>

                                <CheckBox
                                        fx:id="chkNoche"
                                        text="Noche"/>

                            </HBox>


                            <!-- ============================== -->
                            <!-- NORMAS -->
                            <!-- ============================== -->

                            <CheckBox
                                    fx:id="chkNormas"
                                    text="Acepto las normas y reglamentos del centro"
                                    style="-fx-font-weight: bold;"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="5"
                                    GridPane.columnSpan="4"/>

                        </GridPane>


                        <!-- ================================= -->
                        <!-- BOTONES -->
                        <!-- ================================= -->

                        <HBox
                                alignment="CENTER_RIGHT"
                                spacing="12.0">

                            <Button
                                    text="Limpiar"
                                    onAction="#limpiarFormulario"
                                    style="
            -fx-background-color: #E2E8F0;
            -fx-text-fill: #334155;
            -fx-font-weight: bold;
            -fx-background-radius: 7;
            -fx-padding: 10 24;
        "/>


                            <Button
                                    text="Registrar matrícula"
                                    onAction="#registrarEstudiante"
                                    style="
            -fx-background-color: #20639B;
            -fx-text-fill: white;
            -fx-font-weight: bold;
            -fx-background-radius: 7;
            -fx-padding: 10 24;
        "/>

                        </HBox>

                    </VBox>


                    <!-- ====================================== -->
                    <!-- TABLA -->
                    <!-- ====================================== -->

                    <VBox
                            spacing="12.0">

                        <Label
                                text="Estudiantes matriculados"
                                style="-fx-text-fill: #173F5F;">

                            <font>
                                <Font
                                        name="System Bold"
                                        size="21.0"/>
                            </font>

                        </Label>


                        <TableView
                                fx:id="tablaEstudiantes"
                                prefHeight="300.0">

                            <columns>

                                <TableColumn
                                        fx:id="colNombre"
                                        text="Nombre completo"
                                        prefWidth="230.0"/>

                                <TableColumn
                                        fx:id="colDepartamento"
                                        text="Departamento"
                                        prefWidth="170.0"/>

                                <TableColumn
                                        fx:id="colCurso"
                                        text="Curso"
                                        prefWidth="160.0"/>

                                <TableColumn
                                        fx:id="colModalidad"
                                        text="Modalidad"
                                        prefWidth="130.0"/>

                                <TableColumn
                                        fx:id="colHorario"
                                        text="Horario"
                                        prefWidth="170.0"/>

                                <TableColumn
                                        fx:id="colFechaNacimiento"
                                        text="Fecha de nacimiento"
                                        prefWidth="180.0"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>